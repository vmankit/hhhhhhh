# --- Database ---
# Any Postgres 14+ connection string works: Vercel Postgres, Neon, Supabase, etc.
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- App ---
# The public URL of this deployment, no trailing slash.
# Locally: http://localhost:3000
# On Vercel: https://your-app-name.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Google OAuth (from Google Cloud Console, see README) ---
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx

# --- Secrets (generate your own, never reuse these) ---
# Session cookie signing key: openssl rand -hex 32
SESSION_SECRET=
# Token-at-rest encryption key: openssl rand -base64 32  (must decode to 32 bytes)
TOKEN_ENCRYPTION_KEY=

# --- HC Webhook receiver (POST /api/webhook/health) ---
# Shared secret; set the app's custom header to "Authorization: Bearer <this>".
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=
